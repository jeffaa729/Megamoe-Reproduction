FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

ARG DEEPGEMM_REPOSITORY=https://github.com/deepseek-ai/DeepGEMM.git
ARG DEEPGEMM_REF=1fc9c66975ee322d628b3288534ca0e9ce12a64d
ARG DEEPEP_REPOSITORY=https://github.com/deepseek-ai/DeepEP.git
ARG DEEPEP_REF=af9a0403188392824fc3057452822235873e0612
ARG MAX_JOBS=4

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_LINK_MODE=copy
ENV UV_TOOL_BIN_DIR=/usr/local/bin
ENV GPU_KERNELS_PYTHON=/opt/megamoe-env/.venv/bin/python
ENV TORCH_CUDA_ARCH_LIST=9.0
ENV PATH="/usr/local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libdw-dev \
        libibverbs-dev \
        librdmacm-dev \
        ninja-build \
        python3 \
        python3-dev \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Copy uv from its official container image.
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /uvx /usr/local/bin/

# Keep a modern, reproducible CMake version for this repository.
RUN uv tool install cmake==3.31.10

# Cache Python dependencies separately from source code.
WORKDIR /opt/megamoe-env
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project

# Install the official baseline libraries at the benchmarked revisions.
# Its CUDA kernels are JIT-compiled for the attached H100 on first use.
RUN git clone --filter=blob:none --no-checkout "${DEEPGEMM_REPOSITORY}" /tmp/DeepGEMM \
    && git -C /tmp/DeepGEMM checkout --detach "${DEEPGEMM_REF}" \
    && git -C /tmp/DeepGEMM submodule update --init --recursive \
    && uv pip install --python "${GPU_KERNELS_PYTHON}" setuptools wheel ninja packaging \
    && uv pip install --python "${GPU_KERNELS_PYTHON}" --no-build-isolation --no-deps /tmp/DeepGEMM \
    && "${GPU_KERNELS_PYTHON}" -c 'import deep_gemm; assert hasattr(deep_gemm, "m_grouped_bf16_gemm_nt_contiguous")' \
    && rm -rf /tmp/DeepGEMM

RUN git clone --filter=blob:none --no-checkout "${DEEPEP_REPOSITORY}" /tmp/DeepEP \
    && git -C /tmp/DeepEP checkout --detach "${DEEPEP_REF}" \
    && git -C /tmp/DeepEP submodule update --init --recursive \
    && uv pip install --python "${GPU_KERNELS_PYTHON}" --no-build-isolation --no-deps /tmp/DeepEP \
    && "${GPU_KERNELS_PYTHON}" -c 'import deep_ep; assert hasattr(deep_ep, "ElasticBuffer")' \
    && rm -rf /tmp/DeepEP

WORKDIR /root
CMD ["/bin/bash"]
